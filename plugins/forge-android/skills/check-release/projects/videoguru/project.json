{
  "schema_version": 1,
  "id": "videoguru",
  "module": "Guru",
  "variant": "googlePlayRelease",
  "sources": [
    "main",
    "international",
    "googlePlay",
    "release",
    "googlePlayRelease"
  ],
  "modules": [
    "Guru",
    "VideoEngine",
    "player",
    "libCommonGraphics",
    "libGraphicProc"
  ],
  "identity": {
    "settings": "settings.gradle",
    "module_build": "Guru/build.gradle",
    "application_id": "videoeditor.videomaker.videoeditorforyoutube"
  },
  "version_path": "build.gradle",
  "auth_path": "gradle/serverauth.gradle",
  "di": {
    "path": "Guru/src/main/java/com/camerasideas/instashot/UtDependencyInjection.kt",
    "debug": "Guru/src/main/java/com/camerasideas/instashot/common/DebugManager.kt",
    "util": "Guru/src/main/java/com/camerasideas/utils/newutils/AppUtil.kt",
    "test_domains": [
      "speech.inshot.one",
      "aitest.inshot.one"
    ],
    "hook_end": "hookBodyParams",
    "gates": [
      "DebugManager.isDebugMode() && DebugManager.isAiTaskDebug()",
      "if (!debug)",
      "return url"
    ],
    "known_debug": "isReleaseAppVersion",
    "known_util": "lastIndexOf(versionCode)"
  },
  "draft": {
    "roots": [
      "ClipInfo",
      "BaseClipInfo"
    ],
    "registry": "release-draft-tests.json"
  },
  "purchase": {
    "registry": "release-purchase-contracts.json",
    "user": "Guru/src/main/java/com/camerasideas/instashot/common/UserManager.kt",
    "normalization": [
      "replace(\"_\", \"\")",
      "substring(0, 16)"
    ],
    "source_roots": [
      "libinshotpay/src/main/"
    ]
  },
  "gradle": {
    "dependency_task": ":Guru:dependencies",
    "configuration": "googlePlayReleaseRuntimeClasspath",
    "test_task": ":Guru:testGooglePlayDebugUnitTest",
    "exclude": [
      ":Guru:uploadServerAuthTask"
    ],
    "danger_patterns": [
      "upload",
      "publish",
      "install",
      "copy.*baselineprofile",
      "manageddevice",
      "pixel6Api34"
    ]
  },
  "baseline": {
    "task": ":Guru:mergeGooglePlayReleaseBaselineProfile",
    "connected_task": ":BaselineProfile:connectedGooglePlayNonMinifiedReleaseAndroidTest",
    "collect_task": ":BaselineProfile:collectGooglePlayNonMinifiedReleaseBaselineProfile",
    "test": "com.android.baselineprofile.BaselineProfileGenerator",
    "profile_dir": "Guru/src/googlePlayRelease/generated/baselineProfiles",
    "results_dir": "BaselineProfile/build/outputs/androidTest-results/connected/nonminifiedrelease/flavors/googlePlay",
    "files": [
      "baseline-prof.txt",
      "startup-prof.txt"
    ],
    "generation": "supported"
  },
  "capabilities": {
    "version": "supported",
    "auth": "supported",
    "di": "supported",
    "calls": "supported",
    "dependencies": "supported",
    "draft": "supported",
    "purchase": "supported",
    "configs": "supported",
    "baseline": "supported",
    "apk": "supported",
    "tracking": "manual",
    "ai": "manual",
    "remote_config": "manual",
    "channel": "manual",
    "archive": "manual"
  },
